/* Design tokens. Spacing is the primary structuring device — chrome
   (borders/boxes) is spent sparingly, only where it signals a real
   elevation change (a modal floating over content). In-flow content
   stays flat against $background; hierarchy comes from spacing,
   typographic weight, and one accent color used with restraint.
   Color roles ($primary, $surface, $panel, $accent, ...) come from the
   registered nokkam-dark / nokkam-light Theme — see presentation/theme.py. */
$space-xs: 1;
$space-sm: 2;
$space-md: 3;
$space-lg: 4;

Screen {
    background: $background;
    color: $foreground;
}

.panel {
    background: $panel;
    border: round $foreground 10%;
    padding: $space-sm $space-md;
}

.panel:focus-within {
    border: round $accent;
}

.muted {
    color: $foreground 60%;
}

.accent-text {
    color: $accent;
    text-style: bold;
}

/* ---------- Header ---------- */
AppHeader {
    dock: top;
    height: 2;
    padding: 0 2;
    background: $background;
    border-bottom: solid $panel;
}

#app-header-title {
    width: auto;
}

#app-header-meta {
    width: 1fr;
    text-align: right;
    color: $foreground 45%;
}

Footer {
    height: 2;
    background: $background;
    border-top: solid $panel;
}

/* ---------- Modals ---------- */
TaskFormModal, HelpModal, QuickAddModal, PomodoroScreen {
    align: center middle;
    background: $background 70%;
}

#task-form {
    width: 60;
    height: auto;
    padding: 0 2;
}

#task-form Label {
    color: $foreground 55%;
}

#task-form Input, #task-form Select {
    height: 1;
    border: none;
    background: $surface;
}

#task-form .field-row {
    height: 1;
}

#task-form .field-row Input, #task-form .field-row Select {
    width: 1fr;
    margin-right: 1;
}

#task-form .form-actions {
    height: auto;
    margin-top: 1;
}

#task-form #private {
    height: 1;
    margin-top: 1;
    background: transparent;
    border: none;
}

#help-panel {
    /* Wide enough that the longest keybinding line (~80 cols) doesn't
       word-wrap — wrapped lines were inflating this panel's auto-height
       to ~85% of the screen, which is what made it look "stuck at the
       top" instead of centered: there was almost no room left to center
       into. A comfortably wide, short box centers the way it should. */
    width: 92;
    max-width: 100%;
    height: auto;
    max-height: 90%;
    padding: 1 2;
}

#quick-add {
    width: 60;
    height: auto;
    padding: 1 2;
}

#quick-add Input {
    border: none;
    background: $surface;
    height: 1;
}

#text-prompt {
    width: 44;
    height: auto;
    padding: 1 2;
}

#text-prompt Input {
    border: none;
    background: $surface;
    height: 1;
}

Button {
    border: none;
    height: 1;
    min-width: 10;
    background: $surface;
    color: $foreground;
    text-style: none;
}

Button:hover {
    background: $foreground 10%;
}

#save {
    background: $accent;
    color: $background;
    text-style: bold;
}

#save:hover {
    background: $accent 85%;
}

/* ---------- Task list ---------- */
ListView {
    background: $background;
}

ListView:focus {
    background: $foreground 4%;
}

ListItem {
    padding: 0 $space-sm;
}

ListItem:hover {
    background: $foreground 5%;
}

ListView > ListItem.-highlight {
    background: $accent 12%;
}

.priority-high {
    border-left: thick $error;
}

.priority-medium {
    border-left: thick $warning 55%;
}

.priority-low {
    border-left: thick $foreground 12%;
}

.project-group-header {
    margin-top: 1;
    color: $foreground 70%;
}

.project-group-header:first-of-type {
    margin-top: 0;
}

.event-row {
    color: $foreground 70%;
    border-left: thick $secondary 40%;
}

/* ---------- Home: full-width calendar with tasks side by side ---------- */
#home-body {
    height: 1fr;
}

#main-pane {
    width: 2fr;
    height: 1fr;
}

#calendar {
    width: 1fr;
    height: 2fr;
    padding: 1 1;
    border-bottom: solid $panel;
}

#calendar:focus {
    background: $foreground 4%;
}

#calendar-weeks {
    width: 1fr;
    height: auto;
}

.calendar-header-row {
    width: 1fr;
    height: 1;
}

.calendar-week-row {
    width: 1fr;
    height: 4;
}

.weekday-label {
    width: 1fr;
    color: $foreground 40%;
    text-align: left;
    text-style: bold;
}

.weekday-label.weekend {
    color: $secondary;
}

.day-cell {
    width: 1fr;
    height: 1fr;
    text-align: left;
    padding: 0 1;
    color: $foreground 80%;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.day-cell.weekend {
    color: $secondary 90%;
}

.day-cell.other-month {
    color: $foreground 22%;
}

.day-cell.today {
    text-style: bold;
    color: $accent;
}

.day-cell.selected {
    background: $accent 20%;
    border-left: thick $accent;
}

#day-pane {
    width: 1fr;
    height: 1fr;
    padding: 0 2;
}

#day-title {
    padding: 1 0;
    color: $foreground 70%;
}

#day-tasks {
    height: 1fr;
}

#filter-tabs {
    width: 1fr;
    min-width: 20;
    max-width: 40;
    height: 1fr;
    border-left: solid $panel;
}

#projects-list, #tags-list, #task-list {
    height: 1fr;
}

/* ---------- Agenda ---------- */
#agenda-pane {
    width: 1fr;
    max-width: 100;
    height: 1fr;
    padding: 1 2;
}

#agenda-list {
    height: 1fr;
    margin-top: 1;
}

/* ---------- Stats ---------- */
StatsScreen {
    align: center middle;
}

#stats-body {
    width: 56;
    height: auto;
    padding: 2 3;
}

/* ---------- Pomodoro ---------- */
#pomodoro-panel {
    width: 40;
    height: auto;
    padding: 1 2;
    text-align: center;
}
