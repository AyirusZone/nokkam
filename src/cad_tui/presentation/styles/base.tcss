/* Design tokens. Spacing is the primary structuring device — chrome
   (borders/boxes) is spent sparingly, only where it signals a real
   elevation change (a modal floating over content). In-flow content
   stays flat against $background; hierarchy comes from spacing,
   typographic weight, and one accent color used with restraint.
   Color roles ($primary, $surface, $panel, $accent, ...) come from the
   registered cad-dark / cad-light Theme — see presentation/theme.py. */
$space-xs: 1;
$space-sm: 2;
$space-md: 3;
$space-lg: 4;

Screen {
    background: $background;
    color: $foreground;
}

.panel {
    background: $panel;
    border: round $foreground 10%;
    padding: $space-sm $space-md;
}

.panel:focus-within {
    border: round $accent;
}

.muted {
    color: $foreground 60%;
}

.accent-text {
    color: $accent;
    text-style: bold;
}

/* ---------- Header ---------- */
AppHeader {
    dock: top;
    height: 2;
    padding: 0 2;
    background: $background;
    border-bottom: solid $panel;
}

#app-header-title {
    width: auto;
}

#app-header-meta {
    width: 1fr;
    text-align: right;
    color: $foreground 45%;
}

Footer {
    height: 2;
    background: $background;
    border-top: solid $panel;
}

/* ---------- Modals ---------- */
TaskFormModal, HelpModal, QuickAddModal, PomodoroScreen {
    align: center middle;
    background: $background 70%;
}

#task-form {
    width: 60;
    height: auto;
    max-height: 100%;
    padding: 0 2;
}

#task-form Label {
    color: $foreground 55%;
}

#task-form Input, #task-form Select {
    height: 1;
    border: none;
    background: $surface;
}

#task-form .field-row {
    height: 1;
}

#task-form .field-row Input, #task-form .field-row Select {
    width: 1fr;
    margin-right: 1;
}

#help-panel {
    width: 50;
    max-height: 90%;
    padding: 1 2;
}

#quick-add {
    width: 60;
    height: auto;
    padding: 1 2;
}

#quick-add Input {
    border: none;
    background: $surface;
    height: 1;
}

Button {
    border: none;
    height: 1;
    min-width: 10;
    background: $surface;
    color: $foreground;
    text-style: none;
}

Button:hover {
    background: $foreground 10%;
}

#save {
    background: $accent;
    color: $background;
    text-style: bold;
}

#save:hover {
    background: $accent 85%;
}

/* ---------- Task list ---------- */
ListView {
    background: $background;
}

ListItem {
    padding: 0 $space-sm;
}

ListItem:hover {
    background: $foreground 5%;
}

ListView > ListItem.-highlight {
    background: $accent 12%;
}

.priority-high {
    border-left: thick $error;
}

.priority-medium {
    border-left: thick $warning 55%;
}

.priority-low {
    border-left: thick $foreground 12%;
}

/* ---------- Calendar ---------- */
#calendar {
    width: 30;
    height: auto;
    padding: 1 1;
    border-right: solid $panel;
}

#calendar-grid {
    grid-size: 7;
    grid-gutter: 0 1;
    width: 27;
    height: auto;
}

.weekday-label {
    color: $foreground 40%;
    text-align: center;
    height: 1;
}

.day-cell {
    text-align: center;
    height: 1;
    color: $foreground 80%;
}

.day-cell.other-month {
    color: $foreground 22%;
}

.day-cell.today {
    text-style: bold;
    color: $accent;
}

.day-cell.selected {
    background: $accent 25%;
    color: $accent;
    text-style: bold;
}

#day-pane {
    width: 1fr;
    padding: 0 2;
}

#day-title {
    padding: 1 0;
    color: $foreground 70%;
}

/* ---------- Stats ---------- */
#stats-body {
    width: 50;
    margin: 1 2;
    padding: 1 2;
}

/* ---------- Pomodoro ---------- */
#pomodoro-panel {
    width: 40;
    height: auto;
    padding: 1 2;
    text-align: center;
}
