/* Design tokens: spacing scale adapted from Apple HIG's 4/8/12/16/24px
   scale to terminal cell units (a cell has no fractional size). Color
   roles ($primary, $surface, $panel, ...) come from the registered
   cad-dark / cad-light Theme (see presentation/theme.py) — do not
   hardcode colors here. */
$space-xs: 1;
$space-sm: 2;
$space-md: 3;
$space-lg: 4;

Screen {
    background: $background;
    color: $foreground;
}

.panel {
    background: $surface;
    border: round $panel;
    padding: $space-sm $space-md;
}

.panel:focus-within {
    border: round $accent;
}

.muted {
    color: $foreground 60%;
}

.accent-text {
    color: $accent;
    text-style: bold;
}

TaskFormModal, HelpModal, QuickAddModal {
    align: center middle;
    background: $background 60%;
}

#task-form {
    width: 60;
    height: auto;
    max-height: 100%;
    padding: 1 2;
}

#task-form Label {
    color: $foreground 70%;
}

#task-form Input, #task-form Select {
    height: 1;
    border: none;
    background: $panel;
}

#help-panel {
    width: 50;
    max-height: 90%;
    padding: 1 2;
}

#quick-add {
    width: 60;
    height: auto;
    padding: 1 2;
}

#quick-add Input {
    border: none;
    background: $panel;
    height: 1;
}

ListView {
    background: $background;
}

ListItem {
    padding: 0 $space-sm;
}

ListItem:hover {
    background: $panel;
}

ListView > ListItem.-highlight {
    background: $surface;
    border-left: thick $accent;
}

/* Calendar */
#calendar {
    width: 30;
    height: auto;
    padding: 1 1;
    border-right: solid $panel;
}

#calendar-grid {
    grid-size: 7;
    grid-gutter: 0 1;
    width: 28;
    height: auto;
}

.weekday-label {
    color: $foreground 50%;
    text-align: center;
    text-style: bold;
    height: 1;
}

.day-cell {
    text-align: center;
    height: 1;
    color: $foreground;
}

.day-cell.other-month {
    color: $foreground 30%;
}

.day-cell.today {
    text-style: bold;
    color: $accent;
}

.day-cell.selected {
    background: $accent;
    color: $background;
    text-style: bold;
}

#day-pane {
    width: 1fr;
    padding: 0 2;
}

#day-title {
    padding: 1 0;
}
